{
  "name": "@cheesefox/dsh-better-composer",
  "version": "0.1.0",
  "description": "Markdown presentation, long-paste clips, and a live context map for the DSH web composer — a dsh profile plugin.",
  "type": "module",
  "license": "MIT",
  "author": "NoLeftButRight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CheeseFox259/dsh-better-composer.git"
  },
  "bugs": "https://github.com/CheeseFox259/dsh-better-composer/issues",
  "homepage": "https://github.com/CheeseFox259/dsh-better-composer#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "composer",
    "markdown",
    "plugin",
    "context-map",
    "prompt-editor"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "build": "pnpm run bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm run bundle && pnpm pack --pack-destination .pack-check",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run bundle"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@shikijs/langs": "^4.0.0",
    "@tsdown/css": "^0.22.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "anser": "*",
    "clsx": "*",
    "diff": "*",
    "immer": "^10.0.0",
    "jsdom": "^30.1.0",
    "katex": "*",
    "mdast-util-from-markdown": "*",
    "mdast-util-gfm": "*",
    "mdast-util-math": "*",
    "micromark": "*",
    "micromark-core-commonmark": "*",
    "micromark-extension-gfm": "*",
    "micromark-extension-math": "*",
    "micromark-factory-space": "*",
    "micromark-util-character": "*",
    "micromark-util-classify-character": "*",
    "micromark-util-sanitize-uri": "*",
    "micromark-util-symbol": "*",
    "micromark-util-types": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.0.0",
    "simple-icons": "^14.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.0"
  }
}
